  <vhdl name="jk_flip_flop" appearance="logisim_evolution">library ieee;
use ieee.std_logic_1164.all;

entity jk_flip_flop is
    port (
        j    : in  std_logic;
        k    : in  std_logic;
        clk  : in  std_logic;
        q    : out std_logic;
        q_n  : out std_logic
    );
end entity jk_flip_flop;

architecture rtl of jk_flip_flop is
    signal stored : std_logic;
begin
    update_state : process(clk)
    begin
        if rising_edge(clk) then
            case std_logic_vector'(j &amp; k) is
                when "00" =&gt; null;
                when "01" =&gt; stored &lt;= '0';
                when "10" =&gt; stored &lt;= '1';
                when "11" =&gt; stored &lt;= not stored;
                when others =&gt; stored &lt;= 'X';
            end case;
        end if;
    end process;

    q   &lt;= stored;
    q_n &lt;= not stored;
end architecture rtl;
</vhdl>
