  <vhdl name="rs_latch" appearance="logisim_evolution">library ieee;
use ieee.std_logic_1164.all;

entity rs_latch is
    port (
        s   : in  std_logic;
        r   : in  std_logic;
        q   : out std_logic;
        q_n : out std_logic
    );
end entity rs_latch;

architecture nor_gates of rs_latch is
    signal q_feedback   : std_logic;
    signal q_n_feedback : std_logic;
begin
    q_feedback   &lt;= r nor q_n_feedback;
    q_n_feedback &lt;= s nor q_feedback;

    q   &lt;= q_feedback;
    q_n &lt;= q_n_feedback;
end architecture nor_gates;
</vhdl>
